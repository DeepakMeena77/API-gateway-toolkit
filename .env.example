# ── Backend (Render Web Service) ─────────────────────────────────────────────
# Upstash Redis — use rediss:// (TLS) for production
REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379

# Port (Render sets this automatically; only override locally)
PORT=3000

# Tag responses with the instance name so logs show which backend handled each request
INSTANCE_NAME=instance-1

# Lock CORS to your dashboard origin (optional — defaults to * if unset)
# CORS_ORIGIN=https://your-dashboard.onrender.com

# Pre-seed a shared API key on every instance so load tests work across both backends
# Format: key,tier,algorithm
# SEED_KEY=sk_loadtest,free,sliding-window

# ── Dashboard (Render Static Site) ───────────────────────────────────────────
# Set this to your first backend instance URL during the Render static site build
# VITE_API_URL=https://your-instance-1.onrender.com
